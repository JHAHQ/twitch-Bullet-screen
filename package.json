{
  "name": "twitch-bullet-screen",
  "version": "2.3.2",
  "description": "TwitchDanmu",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "JHAHQ",
  "license": "CC-BY-NC-SA-4.0",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.jhahq.twitchdanmu",
    "productName": "TwitchDanmu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/renderer/locales",
        "to": "locales",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "asar": true
  }
}