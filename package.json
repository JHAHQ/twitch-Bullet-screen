{
  "name": "twitch-bullet-screen",
  "version": "2.1.0",
  "description": "專業 Twitch 遊戲彈幕透明層工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JHAHQ/twitch-Bullet-screen.git"
  },
  "keywords": [
    "Twitch",
    "Danmu",
    "Electron",
    "Overlay"
  ],
  "author": "JHAHQ",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JHAHQ/twitch-Bullet-screen/issues"
  },
  "homepage": "https://github.com/JHAHQ/twitch-Bullet-screen#readme",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jhahq.twitchdanmu",
    "productName": "TwitchDanmuOverlay",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}